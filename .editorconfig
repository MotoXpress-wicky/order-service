# Same editor settings in IntelliJ, VS Code and any editor that reads EditorConfig (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Config, web and docs files use two spaces.
[*.{yaml,yml,json,ts,tsx,js,css,html}]
indent_size = 2

# In Markdown two trailing spaces mean a line break.
[*.md]
trim_trailing_whitespace = false

# Windows scripts want CRLF (see .gitattributes).
[*.{cmd,bat}]
end_of_line = crlf
